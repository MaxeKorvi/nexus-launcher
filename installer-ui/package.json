{
  "name": "nexus-launcher-installer",
  "version": "2026.1.1",
  "description": "Custom modern installer frontend for Nexus Launcher",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "author": "Nexus Launcher Team",
  "license": "GPL-3.0-or-later",
  "devDependencies": {
    "electron": "33.4.11"
  },
  "build": {
    "appId": "com.nexuslauncher.installerui",
    "productName": "Nexus Launcher Installer",
    "npmRebuild": false,
    "compression": "store",
    "directories": {
      "output": "../dist/custom-installer"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "styles.css",
      "renderer.js",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "payload/NexusLauncher.zip",
        "to": "payload/NexusLauncher.zip"
      }
    ],
    "win": {
      "target": [
        "portable"
      ],
      "icon": "assets/nexus-logo.png"
    },
    "portable": {
      "artifactName": "Nexus Launcher Setup 2026.1.1.exe",
      "requestExecutionLevel": "user"
    }
  }
}
